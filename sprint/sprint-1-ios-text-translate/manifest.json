  "rec_contract_compliance": {
    "REC-001": {
      "where": "Dashka/Data/Api/DashkaApi.swift → buildRequest(path:method:body:)",
      "behavior": "X-Dashka-Token header injected from Bundle.main.dashkaApiToken when non-nil/non-empty"
    },
    "REC-002": {
      "status": "deferred to Sprint 3A (TTS lang map)",
      "note": "LangCode.speechLocale is BCP-47 for STT, not the TTS ISO 639-1 lowercase code"
    },
    "REC-003": {
      "status": "deferred",
      "note": "Backend enforces 5000-char cap; Sprint 1 client does not pre-validate length. Add in Sprint 2C continuous mode where long buffers become possible."
    },
    "REC-004": {
      "where": "Dashka/Data/Api/DashkaApi.swift → buildRequest(...) sets timeoutInterval = 10.0",
      "behavior": "URLSession enforces per-request timeout"
    },
    "REC-005": {
      "where": "Dashka/Data/Api/DTO/TranslateRequest.swift",
      "behavior": "LangCode.rawValue is canonical uppercase (RU/PL/...) — sent verbatim; backend ALLOWED_LANGS will validate"
    }
  },
